# Pooled connection (used at runtime). On Neon: the URL with -pooler in the hostname.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Direct connection (used by prisma migrate). On Neon: the URL without -pooler.


# AI provider: "ollama" is the only one built in. See CONTRIBUTING.md to add more.
AI_PROVIDER="ollama"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Used for streak day boundaries. Any IANA timezone, e.g. "America/New_York".
APP_TIMEZONE="UTC"

# Optional, for testing timer quests. 0.5 = half the duration must pass. 0 = no wait.
# TIMER_MIN_RATIO="0.5"